{
  "name": "@yaaif/cursor-mcp",
  "version": "0.10.2",
  "description": "YAA\\F Cursor MCP bridge — ops support, local tools, profiles, auth, doctor, plan, skills, MCP, ambient, desktop, approvals",
  "type": "module",
  "license": "Apache-2.0",
  "author": "YAA\\F / BeezLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaaif/cursor-plugin.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "yaaif-cursor-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/fix-shebang.mjs && npm run bundle",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=../../dist/yaaif-cursor-mcp.mjs --packages=bundle",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "generate:local-tools-ref": "node ./scripts/generate-local-tools-ref.mjs",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "open": "^10.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
